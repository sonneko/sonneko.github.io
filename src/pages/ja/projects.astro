---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`開発物・OSS | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header lang="ja" />
		<main>
			<h1>開発物・OSS一覧</h1>
			<p>
				<a href="https://github.com/sonneko" target="_blank">GitHub</a> 上で公開・開発している自作言語、コンパイラ、AI向けCLI・執筆ツール、ブラウザアプリ、教材の一覧です。
			</p>

			<h3>コンパイラ・言語設計</h3>
			<ul>
				<li>
					<b>Hydent Lang</b>: Rustで実装中の静的型付け・LLVM/JITコンパイル方式のモダンなプログラミング言語。TypeScript風の親しみやすい構文と、<code>Option&lt;T&gt;</code>によるNull安全、<code>Result&lt;T, E&gt;</code>および<code>try fn</code>による二層エラー処理、コンパイラ検証付きドキュメントディレクティブ（<code>#summary</code>, <code>#panics</code>）を備えています。
					<a href="https://github.com/sonneko/hydent-lang" target="_blank">Repo</a> / <a href="https://sonneko.github.io/hydent-lang/" target="_blank">Site</a>
				</li>
				<li>
					<b>funky-lang</b>: Hindley-Milner型推論、バイトコードコンパイラ・検証器、明示的な呼び出しフレームを持つスタックVMを備えたRust製の関数型プログラミング言語。
					<a href="https://github.com/sonneko/funky-lang" target="_blank">Repo</a> / <a href="https://sonneko.github.io/funky-lang/" target="_blank">Site</a>
				</li>
				<li>
					<b>tibineko</b>: <code>hydent-lang</code> から切り出された、依存関係ゼロ・ベンダリング方式の再帰下降パーサジェネレータ。TypeScript製DSLとトークンマップから、Rustのパーサ・AST型・ビジター・スキャナテーブルを生成します。
					<a href="https://github.com/sonneko/tibineko" target="_blank">Repo</a>
				</li>
				<li>
					<b>sonneko-arch</b>: 低レイヤ学習のためにゼロから設計したオリジナルCPUアーキテクチャと、アセンブラSDK・エミュレータ群。
					<a href="https://github.com/sonneko/sonneko-arch" target="_blank">Arch</a> / <a href="https://github.com/sonneko/sonneko-arch-sdk" target="_blank">SDK</a> / <a href="https://github.com/sonneko/sonneko-arch-emu" target="_blank">Emulator</a>
				</li>
			</ul>

			<h3>AI・執筆・CLIツール</h3>
			<ul>
				<li>
					<b>novnow</b>: 長編小説やノベルゲームのためのアルゴリズム小説執筆IDEおよび世界観管理フォーマット（novnow形式）。ブラウザ、デスクトップ、CLI、LSP、AI連携用MCP、VS Code拡張、GitHub Actions、<a href="https://pypi.org/project/novnow/" target="_blank">PyPI</a> で利用可能です。
					<a href="https://github.com/sonneko/novnow" target="_blank">Repo</a> / <a href="https://sonneko.github.io/novnow/app/" target="_blank">Web App</a>
				</li>
				<li>
					<b>llmsearch</b>: 検索結果 &rarr; 見出し一覧 &rarr; 本文の順に段階的にWebを調査し、LLMのコンテキスト消費を抑えるRust製CLIツール。エンジン定義やクォータもJSONで宣言的に切り替えられます。
					<a href="https://github.com/sonneko/llmsearch" target="_blank">Repo</a>
				</li>
				<li>
					<b>mdbook-sitemap</b>: mdBookプロジェクトの <code>sitemap.xml</code> を自動生成するRust製バックエンド（<a href="https://crates.io/crates/mdbook-sitemap" target="_blank">crates.io</a> にて公開中）。
					<a href="https://github.com/sonneko/mdbook-sitemap" target="_blank">Repo</a>
				</li>
				<li>
					<b>Investment Simulator</b>: GitHub Actions・Yahoo Finance・Geminiを活用したLLMによる投資シミュレーター。
					<a href="https://github.com/sonneko/investment-simulator" target="_blank">Repo</a> / <a href="https://sonneko.github.io/investment-simulator/" target="_blank">Site</a>
				</li>
				<li>
					<b>std-app-dev-template</b>: LLMによる仕様駆動開発とCI検証のためのリポジトリテンプレート。
					<a href="https://github.com/sonneko/std-app-dev-template" target="_blank">Repo</a>
				</li>
			</ul>

			<h3>ブラウザアプリ・教材</h3>
			<ul>
				<li>
					<b>Offline Runner</b>: 複数のプログラミング言語をブラウザ上で完全オフライン実行できるツール。
					<a href="https://github.com/sonneko/offline-runner" target="_blank">Repo</a> / <a href="http://offline-app-sonneko.aoristos.net/" target="_blank">App</a>
				</li>
				<li>
					<b>Offline Lean 3 Web Editor</b>: ブラウザ上でオフライン動作する定理証明支援系 Lean 3 エディタ。
					<a href="https://github.com/sonneko/offline-lean-web-editor" target="_blank">Repo</a> / <a href="https://sonneko.github.io/offline-lean-web-editor/" target="_blank">App</a>
				</li>
				<li>
					<b>Air Keyboard</b>: Google MediaPipe の手指検出を利用した、カメラベースの仮想キーボード＆マウス。
					<a href="https://github.com/sonneko/air-keyboard" target="_blank">Repo</a> / <a href="https://air-keyboard-sonneko.aoristos.net" target="_blank">Demo</a>
				</li>
				<li>
					<b>AirLink</b>: QRコードでシグナリングするサーバーレス・P2PのWebRTCチャットPWA（Next.js + TypeScript）。
					<a href="https://github.com/sonneko/air-link-by-ai" target="_blank">Repo</a> / <a href="https://sonneko.github.io/air-link-by-ai/" target="_blank">App</a>
				</li>
				<li>
					<b>Life Game Studio</b>: ライフゲームのパターンや生物を共有できるRust製SNSプラットフォーム。
					<a href="https://github.com/sonneko/life-game-studio" target="_blank">Repo</a>
				</li>
				<li>
					<b>Programming Book</b>: プログラミングとコンピュータサイエンスの包括的な地図を目指した初心者向け教科書。
					<a href="https://github.com/sonneko/programming-book" target="_blank">Repo</a> / <a href="https://sonneko.github.io/programming-book/" target="_blank">読む</a>
				</li>
				<li>
					<b>Rust Book 日本語訳（pr-rust-book-ja）</b>: RustDevelopersJP を通じた『The Rust Programming Language』日本語版への翻訳コントリビューション。
					<a href="https://github.com/sonneko/pr-rust-book-ja" target="_blank">Repo</a> / <a href="https://doc.rust-jp.rs/book-ja/" target="_blank">ドキュメント</a>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
