---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header lang="en" />
		<main>
			<h1>Projects &amp; OSS</h1>
			<p>
				A categorized index of programming languages, compilers, AI developer tools, browser applications, and educational resources built on <a href="https://github.com/sonneko" target="_blank">GitHub</a>.
			</p>

			<h3>Compilers, Languages &amp; Architecture</h3>
			<ul>
				<li>
					<b>Hydent Lang</b>: A modern, statically-typed, LLVM/JIT-compiled language written in Rust. 
					<a href="https://github.com/sonneko/hydent-lang" target="_blank">Repo</a> / <a href="https://sonneko.github.io/hydent-lang/" target="_blank">Site</a>
				</li>
				<li>
					<b>funky-lang</b>: A functional programming language seeking beauty only
					<a href="https://github.com/sonneko/funky-lang" target="_blank">Repo</a> / <a href="https://sonneko.github.io/funky-lang/" target="_blank">Site</a>
				</li>
				<li>
					<b>tibineko</b>: A zero-dependency, vendored recursive-descent parser generator extracted from <code>hydent-lang</code>. Takes a grammar DSL and token map in TypeScript and emits a Rust parser, AST types, visitor/printer, and scanner tables.
					<a href="https://github.com/sonneko/tibineko" target="_blank">Repo</a>
				</li>
			</ul>

			<h3>AI Tooling, Authoring &amp; Developer Utilities</h3>
			<ul>
				<li>
					<b>novnow</b>: An algorithmic novel writing IDE and deterministic world-management format for long-form fiction. Available as a Browser app, Desktop app, CLI, LSP, MCP server for AI integration, VS Code extension, GitHub Action, and <a href="https://pypi.org/project/novnow/" target="_blank">PyPI package</a>.
					<a href="https://github.com/sonneko/novnow" target="_blank">Repo</a> / <a href="https://sonneko.github.io/novnow/app/" target="_blank">Web App</a>
				</li>
				<li>
					<b>llmsearch</b>: A Rust CLI that researches the web progressively (search results &rarr; headings outline &rarr; selected sections) to minimize LLM context consumption, with JSON-configured engines and quotas.
					<a href="https://github.com/sonneko/llmsearch" target="_blank">Repo</a>
				</li>
				<li>
					<b>mdbook-sitemap</b>: A Rust backend for <code>mdBook</code> published on <a href="https://crates.io/crates/mdbook-sitemap" target="_blank">crates.io</a> that automatically generates <code>sitemap.xml</code>.
					<a href="https://github.com/sonneko/mdbook-sitemap" target="_blank">Repo</a>
				</li>
				<li>
					<b>Investment Simulator</b>: An LLM-powered investment simulation built with GitHub Actions, Yahoo Finance, and Gemini.
					<a href="https://github.com/sonneko/investment-simulator" target="_blank">Repo</a> / <a href="https://sonneko.github.io/investment-simulator/" target="_blank">Site</a>
				</li>
				<li>
					<b>std-app-dev-template</b>: A specification-driven application development template tailored for LLM-assisted workflows and CI verification.
					<a href="https://github.com/sonneko/std-app-dev-template" target="_blank">Repo</a>
				</li>
			</ul>

			<h3>Browser Apps, WebRTC, MediaPipe &amp; Education</h3>
			<ul>
				<li>
					<b>Offline Lean 3 Web Editor</b>: An offline Lean 3 theorem prover editor running in the browser.
					<a href="https://github.com/sonneko/offline-lean-web-editor" target="_blank">Repo</a> / <a href="https://sonneko.github.io/offline-lean-web-editor/" target="_blank">App</a>
				</li>
				<li>
					<b>Air Keyboard</b>: A experiment of a camera-based virtual keyboard and mouse powered by Google MediaPipe hand tracking.
					<a href="https://github.com/sonneko/air-keyboard" target="_blank">Repo</a> / <a href="https://air-keyboard-sonneko.aoristos.net" target="_blank">Demo</a>
				</li>
				<li>
					<b>AirLink</b>: No server, ephemeral P2P WebRTC chat PWA using QR-code signaling (Next.js + TypeScript).
					<a href="https://github.com/sonneko/air-link-by-ai" target="_blank">Repo</a> / <a href="https://sonneko.github.io/air-link-by-ai/" target="_blank">App</a>
				</li>
				<li>
					<b>Life Game Studio</b>: A Rust-based social platform for sharing Conway's Game of Life patterns and creatures.
					<a href="https://github.com/sonneko/life-game-studio" target="_blank">Repo</a>
				</li>
				<li>
					<b>Programming Book</b>: A comprehensive modern map &amp; textbook of computer science and programming for beginners (in Japanese).
					<a href="https://github.com/sonneko/programming-book" target="_blank">Repo</a> / <a href="https://sonneko.github.io/programming-book/" target="_blank">Read</a>
				</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
