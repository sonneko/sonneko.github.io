---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header lang="en" />
		<main>
			<h1>I'm Sonneko.<img src="/fonts/icon.png" width="100" class="icon-image" alt="Sonneko's icon" /></h1>
			<SocialLinks />

			<p>
				Nice to meet you, I'm Sonneko. I'm a high school student in Japan studying computer science and mathematics as a hobby. My motto is to value both theory and practice.
			</p>

			<p>
				I am one of the founders of <a href="https://aoristos.net" target="_blank">Aoristos</a>, a high-schooler-led inquiry and self-study organization, and a member of the Japanese Rust community <a href="https://rust-jp.rs/" target="_blank">RustDevelopersJP</a>.
			</p>

			<h3>Interests &amp; Tech Stack</h3>
			<table>
				<thead>
					<tr>
						<th>Field</th>
						<th>Key Technologies &amp; Interests</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Languages</td>
						<td>Rust, TypeScript, Python (Learning: Go, Zig, Haskell, Lean)</td>
					</tr>
					<tr>
						<td>Systems &amp; Compilers</td>
						<td>LLVM / JIT, Parser Generators, Bytecode VMs, CPU Design, WebAssembly</td>
					</tr>
					<tr>
						<td>Web &amp; Interactive</td>
						<td>Astro, Next.js, Svelte, Solid.js, WebRTC, MediaPipe</td>
					</tr>
					<tr>
						<td>AI &amp; Infrastructure</td>
						<td>LLM Integration / MCP, Spec-Driven Development, Gemini, GitHub Actions, Cloudflare</td>
					</tr>
				</tbody>
			</table>

			<h3>Pages</h3>
			<ul>
				<li><a href="/projects"><b>Projects &amp; OSS</b></a> — Custom languages (<code>Hydent Lang</code>, <code>funky-lang</code>, <code>tibineko</code>), AI &amp; writing tools (<code>novnow</code>, <code>llmsearch</code>, <code>mdbook-sitemap</code>), browser apps, etc.</li>
				<li><a href="/achievements"><b>Achievements, Writing &amp; Activities</b></a> — Science Koshien, ReaBiz, Suuri no Tsubasa, Zenn technical books &amp; articles, and posts on Note, Qiita, and Dev.to.</li>
				<li><a href="/blog"><b>Blog</b></a> — Event recaps and notes.</li>
			</ul>

			<h3>Contact</h3>
			<p>
				For questions or inquiries, feel free to reach out via <a href="https://github.com/sonneko/sonneko" target="_blank">GitHub repository Issues</a> or <a href="https://x.com/_sonneko" target="_blank">X (Twitter) DM</a>.<br />
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 15px;
	}
	.icon-image {
		display: block;
	}
</style>
