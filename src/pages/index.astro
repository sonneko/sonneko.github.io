---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header lang="en" />
		<main>
			<h1>I'm Sonneko.<img src="/fonts/icon.png" width="100" class="icon-image" alt="Sonneko's icon" /></h1>
			<SocialLinks />

			<p>
				Hello, I'm Sonneko, a high school programmer and compiler engineer in Japan. Guided by the perspective that <em>"the world is a graph of impure functions,"</em> I enjoy exploring abstract structure across computer science and mathematics and turning theory into working systems.
			</p>

			<p>
				I founded the independent student-led research organization <a href="https://aoristos.net" target="_blank">Aoristos</a> and participate in the <a href="https://rust-jp.rs/" target="_blank">RustDevelopersJP</a> community.
			</p>

			<h3>Focus &amp; Tech Stack</h3>
			<table>
				<thead>
					<tr>
						<th>Domain</th>
						<th>Focus</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Languages</td>
						<td>Rust, TypeScript, Python, Lean (Exploring: Go, Zig, Haskell)</td>
					</tr>
					<tr>
						<td>Systems &amp; Compilers</td>
						<td>LLVM / JIT, Parser Generators, Bytecode VMs, CPU Architecture, WebAssembly</td>
					</tr>
					<tr>
						<td>Web &amp; Interactive</td>
						<td>Astro, Next.js, Svelte, Solid.js, WebRTC, MediaPipe</td>
					</tr>
					<tr>
						<td>AI &amp; Tooling</td>
						<td>LLM Context Tooling, MCP, Spec-Driven Dev, GitHub Actions, Cloudflare</td>
					</tr>
				</tbody>
			</table>

			<h3>Explore More</h3>
			<ul>
				<li><a href="/projects"><b>Projects &amp; OSS</b></a> — Compilers (<code>Hydent Lang</code>, <code>funky-lang</code>, <code>tibineko</code>), AI/authoring tools (<code>novnow</code>, <code>llmsearch</code>, <code>mdbook-sitemap</code>), and browser apps.</li>
				<li><a href="/achievements"><b>Achievements &amp; Writing</b></a> — Science Koshien, ReaBiz, Wing of Math &amp; Science, Zenn book &amp; technical articles.</li>
				<li><a href="/blog"><b>Blog</b></a> — Notes, event reports, and essays.</li>
			</ul>

			<h3>Contact</h3>
			<p>
				Feel free to open an issue in <a href="https://github.com/sonneko/sonneko" target="_blank">this repository</a>, send <a href="https://x.com/_sonneko" target="_blank">a DM on X (Twitter)</a>, or reach out by email:<br />
				<code>sonneko[at]aoristos.net</code> (replace <code>[at]</code> with <code>@</code>)
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.icon-image {
		margin-left: 15px;
		vertical-align: middle;
	}
</style>
