---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
	lang: "ja" | "en"
}

const { lang } = Astro.props;

---

<header>
	<nav>
		<h2><a href={lang === "ja" ? "/ja" : "/"}>{SITE_TITLE}</a></h2>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="global-menu" aria-label={lang === "ja" ? "メニューを開く" : "Open menu"} data-open-label={lang === "ja" ? "メニューを開く" : "Open menu"} data-close-label={lang === "ja" ? "メニューを閉じる" : "Close menu"}>
			<span></span><span></span><span></span>
		</button>
		<div class="internal-links" id="global-menu">
			{lang === "en" ? (
				<>
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href="/projects">Projects</HeaderLink>
					<HeaderLink href="/achievements">Achievements</HeaderLink>
					<HeaderLink href="/blog">Blog</HeaderLink>
					<HeaderLink href="/ja">JA</HeaderLink>
				</>
			) : (
				<>
					<HeaderLink href="/ja">ホーム</HeaderLink>
					<HeaderLink href="/ja/projects">開発物</HeaderLink>
					<HeaderLink href="/ja/achievements">実績・執筆</HeaderLink>
					<HeaderLink href="/ja/blog">ブログ</HeaderLink>
					<HeaderLink href="/">EN</HeaderLink>
				</>
			)}
		</div>
		<div class="social-links">
			<a href="https://github.com/sonneko" target="_blank">
				<span class="sr-only">Go to Sonneko's Github Profile</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="https://zenn.dev/sonneko" target="_blank">
				<span class="sr-only">Go to Sonneko's Zenn Profile</span>
				<img src="/fonts/zenn.svg" width="32" height="32" alt="Zenn" />
			</a>
			<a href="https://dev.to/ku_0dfe543e8243f19f5" target="_blank">
				<span class="sr-only">Go to Sonneko's Dev.to Profile</span>
				<img src="/fonts/dev-to.svg" width="32" height="32" alt="Dev.to" />
			</a>
		</div>
	</nav>
</header>
<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const menu = document.getElementById('global-menu');
	function setExpanded(expanded: boolean) {
		if (!toggle) return;
		toggle.setAttribute('aria-expanded', String(expanded));
		toggle.setAttribute('aria-label', expanded ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!);
	}
	toggle?.addEventListener('click', () => {
		setExpanded(toggle.getAttribute('aria-expanded') !== 'true');
	});
	document.addEventListener('click', (event) => {
		if (event.target instanceof Node && !toggle?.contains(event.target) && !menu?.contains(event.target)) {
			setExpanded(false);
		}
	});
	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
			setExpanded(false);
			toggle.focus();
		}
	});
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 10px 1em 0;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		line-height: 1;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		box-sizing: border-box;
		width: fit-content;
		max-width: calc(100% - 2rem);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		font-size: 0.95rem;
		background-color: rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 3px 10px 0 rgba(31, 38, 135, 0.17);
		border: 1px solid rgba(255, 255, 255, 0.5);
		border-radius: 20px;
		padding: 0 1rem;
		overflow: hidden;
		flex-wrap: wrap;
	}
	nav a {
		padding: 0.85rem 0.4rem;
		color: rgb(var(--black));
		line-height: 1;
		white-space: nowrap;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.internal-links {
		display: flex;
		justify-content: center;
		gap: 0.4rem;
		flex-wrap: wrap;
	}
	.menu-toggle {
		display: none;
	}
	@media (max-width: 720px) {
		.menu-toggle {
			display: flex;
			flex-direction: column;
			justify-content: center;
			align-items: center;
			gap: 5px;
			width: 44px;
			height: 44px;
			padding: 0;
			border: 0;
			background: transparent;
			color: rgb(var(--black));
			cursor: pointer;
		}
		.menu-toggle span {
			width: 22px;
			height: 2px;
			background: currentColor;
			transition: transform 0.2s ease, opacity 0.2s ease;
		}
		.menu-toggle[aria-expanded="true"] span:first-child {
			transform: translateY(7px) rotate(45deg);
		}
		.menu-toggle[aria-expanded="true"] span:nth-child(2) {
			opacity: 0;
		}
		.menu-toggle[aria-expanded="true"] span:last-child {
			transform: translateY(-7px) rotate(-45deg);
		}
		.menu-toggle:focus-visible {
			outline: 2px solid currentColor;
			outline-offset: 2px;
		}
		.social-links {
			display: none;
		}
		nav {
			position: relative;
			overflow: visible;
			width: 100%;
			max-width: none;
			padding: 0.5rem 0.75rem;
			justify-content: space-between;
			align-items: center;
			gap: 0.5rem;
		}
		nav a {
			padding: 0.2em 0.35em;
			font-size: 0.85em;
		}
		h2 {
			width: auto;
			text-align: left;
			font-size: 0.9em;
		}
		.internal-links {
			position: absolute;
			top: calc(100% + 0.5rem);
			left: 0;
			box-sizing: border-box;
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			width: 100%;
			max-height: calc(100dvh - 6rem);
			overflow-y: auto;
			overscroll-behavior: contain;
			padding: 0.5rem 0.75rem;
			background-color: rgba(255, 255, 255, 0.96);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			box-shadow: 0 3px 10px 0 rgba(31, 38, 135, 0.17);
			border: 1px solid rgba(255, 255, 255, 0.5);
			border-radius: 20px;
			opacity: 0;
			visibility: hidden;
			transform: translateY(-0.5rem);
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
		}
		.menu-toggle[aria-expanded="true"] + .internal-links {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
		}
		.internal-links a {
			box-sizing: border-box;
			width: 100%;
			padding: 0.85rem 0.5rem;
			font-size: 1rem;
			line-height: 1.4;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.menu-toggle span,
		.internal-links,
		.menu-toggle[aria-expanded="true"] + .internal-links {
			transition: none;
		}
	}
</style>
